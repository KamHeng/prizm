# Copy to .env and fill in, or export these in your shell before ./gradlew bootRun.
# .env is gitignored; this example file is not. Never put real values here.
#
# application.yml declares both with no default, so the application refuses to
# start if either is missing rather than running with a blank credential.

# Credential for the internal audit service. Sent as a bearer token.
# The value previously hardcoded in AuditClient.java must be treated as
# compromised — it is in git history — and rotated rather than reused here.
AUDIT_API_KEY=

# Override only if pointing at a non-default audit host.
# AUDIT_URL=http://internal-audit.prizm.local/api/v2/events

# HS256 signing secret for request JWTs. Minimum 32 bytes; the application
# fails fast if shorter. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=
